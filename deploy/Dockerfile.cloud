# Cloud variant of deploy/Dockerfile. Builds everything inside Docker
# so CI doesn't need a separate host-side `cargo build` step, and uses
# cargo-chef to keep the dependency-graph compilation as its own layer
# (cached across rebuilds when Cargo.lock hasn't changed).
#
# Stages:
#   chef        — rust + system libs + cargo-chef
#   planner     — emits recipe.json from the full source tree
#   deps        — compiles every workspace dep against the recipe
#   sql         — separate Maven build of the SQL compiler jar
#   builder     — copies real sources over deps' dummies and builds
#                 the pipeline-manager binary
#   runtime     — slim ubuntu:24.04 + JRE + the two artifacts
#
# Cold build is comparable to the old single-stage flow (~10 min).
# Warm rebuilds where only crate sources changed land in 1–3 min:
# the chef + deps layers come from the registry cache (cache-from=gha)
# and the builder stage only recompiles the changed crate(s).

# ---------- 1. Toolchain base ------------------------------------------------

FROM rust:1.93-bookworm AS chef
ENV DEBIAN_FRONTEND=noninteractive \
    OPENSSL_NO_VENDOR=1 \
    OPENSSL_STATIC=1 \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        libclang-dev \
        libssl-dev pkg-config \
        cmake \
        golang-go \
        libsasl2-dev zlib1g-dev \
        build-essential \
        curl ca-certificates \
        unzip \
 && rm -rf /var/lib/apt/lists/*
# bun + node — pipeline-manager's build.rs runs `bun clean-install`
# to bundle the web-console as embedded static assets.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get update && apt-get install -y nodejs && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://bun.sh/install | bash \
 && ln -s /root/.bun/bin/bun /usr/local/bin/bun
RUN cargo install cargo-chef --locked --version ^0.1
WORKDIR /src

# ---------- 2. Recipe: deps-only snapshot ------------------------------------

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ---------- 3. Cook: build the dep graph (the cached layer) ------------------

FROM chef AS deps
COPY --from=planner /src/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json -p pipeline-manager

# ---------- 4. SQL compiler jar (parallelisable with stage 3) ----------------

FROM maven:3.9-eclipse-temurin-21 AS sql
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /src
COPY sql-to-dbsp-compiler/ ./sql-to-dbsp-compiler/
WORKDIR /src/sql-to-dbsp-compiler
RUN ./build.sh

# ---------- 5. Build the manager binary --------------------------------------

FROM deps AS builder
COPY . .
RUN cargo build --release --locked -p pipeline-manager
# Sanity-check the binary's existence so the failure mode below is
# obvious if the build silently produced nothing.
RUN test -f /src/target/release/pipeline-manager

# ---------- 6. Runtime: ubuntu + JRE + Rust toolchain ------------------------
#
# Runtime still needs a working Rust toolchain because pipeline-manager
# invokes `cargo build` per pipeline to compile the Rust code emitted
# by SQL-to-DBSP. The previous "slim" runtime stripped this and broke
# every pipeline at the Rust-compile boundary ("running 'cargo build':
# No such file or directory"). Match the upstream deploy/Dockerfile:
# rustup with the same 1.93.1 toolchain as the chef stage, plus the
# system dev libs the generated crate's build.rs scripts link against
# (rdkafka -> libsasl2-dev / zlib1g-dev, openssl-sys -> libssl-dev /
# pkg-config, bindgen -> libclang-dev, prost-build -> cmake).

FROM ubuntu:24.04 AS release
ENV DEBIAN_FRONTEND=noninteractive \
    OPENSSL_NO_VENDOR=1 \
    OPENSSL_STATIC=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        openjdk-21-jre-headless \
        ca-certificates tzdata \
        locales \
        libcap2-bin \
        git \
        curl \
        build-essential \
        pkg-config \
        cmake \
        libssl-dev \
        libsasl2-dev zlib1g-dev \
        libclang-dev \
 && rm -rf /var/lib/apt/lists/*
RUN curl -sS https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
      -o /usr/local/share/ca-certificates/aws-global-rds-bundle.crt \
 && update-ca-certificates || true
RUN sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
 && locale-gen
USER ubuntu
WORKDIR /home/ubuntu
# rustup + the exact toolchain version the binary was built against
# (1.93.1, matching the chef stage's rust:1.93-bookworm). --profile
# minimal keeps install at ~150 MB instead of dragging in rustfmt /
# clippy / rust-docs.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain 1.93.1
# sccache is configured as RUSTC_WRAPPER on the compile-pool Fly app
# (with a Tigris S3 backend, so per-pipeline crate compilations share
# a cache across machines). Install the official prebuilt binary so
# the wrapper actually exists; without it cargo aborts with
# "could not execute process `sccache .../rustc`: No such file".
#
# mold is the linker. The per-pipeline binary is ~278 MB; linking it
# with the default ld is the slowest single step in a fully-cached
# warm cargo build (sccache covers rustc but not the linker). mold
# is typically 3-8x faster than ld for binaries this size and is a
# drop-in replacement enabled via RUSTFLAGS=-C link-arg=-fuse-ld=mold
# (set on the compile-pool fly.toml so users' SQL pipelines link
# faster, and on the engine build via the chef stage if we ever cold-
# build the engine here).
USER root
RUN ARCH=$(uname -m) \
 && SCCACHE_VER=v0.8.2 \
 && curl -sSL "https://github.com/mozilla/sccache/releases/download/${SCCACHE_VER}/sccache-${SCCACHE_VER}-${ARCH}-unknown-linux-musl.tar.gz" \
      -o /tmp/sccache.tar.gz \
 && tar -xzf /tmp/sccache.tar.gz -C /tmp \
 && install -m 0755 "/tmp/sccache-${SCCACHE_VER}-${ARCH}-unknown-linux-musl/sccache" /usr/local/bin/sccache \
 && rm -rf /tmp/sccache.tar.gz "/tmp/sccache-${SCCACHE_VER}-${ARCH}-unknown-linux-musl"
RUN ARCH=$(uname -m) \
 && MOLD_VER=v2.40.1 \
 && curl -sSL "https://github.com/rui314/mold/releases/download/${MOLD_VER}/mold-${MOLD_VER#v}-${ARCH}-linux.tar.gz" \
      -o /tmp/mold.tar.gz \
 && tar -xzf /tmp/mold.tar.gz -C /tmp \
 && install -m 0755 "/tmp/mold-${MOLD_VER#v}-${ARCH}-linux/bin/mold" /usr/local/bin/mold \
 && install -m 0755 "/tmp/mold-${MOLD_VER#v}-${ARCH}-linux/bin/ld.mold" /usr/local/bin/ld.mold \
 && rm -rf /tmp/mold.tar.gz "/tmp/mold-${MOLD_VER#v}-${ARCH}-linux"
USER ubuntu
ENV PATH="/home/ubuntu/.cargo/bin:${PATH}" \
    LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 LANGUAGE=en_US:en BANNER_ADDR=localhost
# Match the existing image layout so the ENTRYPOINT below is identical
# to deploy/Dockerfile and works for any downstream tooling that
# assumes those paths (e.g. operator scripts).
COPY --from=builder --chown=ubuntu /src/target/release/pipeline-manager \
        /home/ubuntu/feldera/build/pipeline-manager
COPY --from=sql --chown=ubuntu \
        /src/sql-to-dbsp-compiler/SQL-compiler/target/sql2dbsp-jar-with-dependencies.jar \
        /home/ubuntu/feldera/build/sql2dbsp-jar-with-dependencies.jar
COPY --chown=ubuntu Cargo.lock /home/ubuntu/feldera/Cargo.lock
# Workspace root manifest. Per-pipeline `cargo build` invocations
# pull in crates from /home/ubuntu/feldera/crates (e.g. dbsp), and
# those crates inherit `rust-version`, `edition`, etc. from
# `workspace.package` in this Cargo.toml. Without it cargo errors
# with "failed to find a workspace root" mid-resolution.
COPY --chown=ubuntu Cargo.toml /home/ubuntu/feldera/Cargo.toml
COPY --chown=ubuntu sql-to-dbsp-compiler/lib /home/ubuntu/feldera/sql-to-dbsp-compiler/lib
COPY --chown=ubuntu sql-to-dbsp-compiler/temp /home/ubuntu/feldera/sql-to-dbsp-compiler/temp
COPY --chown=ubuntu sql-to-dbsp-compiler/SQL-compiler/sql-to-dbsp \
        /home/ubuntu/feldera/sql-to-dbsp-compiler/SQL-compiler/sql-to-dbsp
COPY --chown=ubuntu crates/pipeline-manager/demos/sql /home/ubuntu/feldera/demos/sql
# `--dbsp-override-path` points at this directory so the Rust pipeline
# can resolve dbsp sources during compile.
COPY --chown=ubuntu crates /home/ubuntu/feldera/crates
# Entrypoint shim. Mirrors AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# into the OPENDAL_S3_* names sccache v0.8 needs to authenticate to
# its S3 backend. See deploy/entrypoint.sh for the why.
COPY --chmod=0755 deploy/entrypoint.sh /usr/local/bin/feldera-entrypoint
ENTRYPOINT ["/usr/local/bin/feldera-entrypoint", "--bind-address=0.0.0.0", "--sql-compiler-path=/home/ubuntu/feldera/build/sql2dbsp-jar-with-dependencies.jar", "--compilation-cargo-lock-path=/home/ubuntu/feldera/Cargo.lock", "--dbsp-override-path=/home/ubuntu/feldera", "--demos-dir", "/home/ubuntu/feldera/demos/sql"]
